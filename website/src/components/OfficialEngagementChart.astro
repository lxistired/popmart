---
// website/src/components/OfficialEngagementChart.astro
import officialData from '../data/official-engagement.json';

const data = officialData as any;
const tkSeries = data.tiktok || [];
const igSeries = data.instagram || [];

const allMonths = [...new Set([
  ...tkSeries.map((r: any) => r.month),
  ...igSeries.map((r: any) => r.month),
])].sort() as string[];

const chartData = JSON.stringify({
  months: allMonths,
  tiktok: allMonths.map(m => {
    const row = tkSeries.find((r: any) => r.month === m);
    return row ? row.avg_comments : null;
  }),
  instagram: allMonths.map(m => {
    const row = igSeries.find((r: any) => r.month === m);
    return row ? row.avg_comments : null;
  }),
  tiktokPosts: allMonths.map(m => {
    const row = tkSeries.find((r: any) => r.month === m);
    return row ? row.posts : 0;
  }),
  instagramPosts: allMonths.map(m => {
    const row = igSeries.find((r: any) => r.month === m);
    return row ? row.posts : 0;
  }),
});
---
<section class="section">
  <div class="section-header">
    <h2>官方号帖子热度</h2>
    <span class="en">Official Post Engagement</span>
  </div>
  <p class="chart-subtitle">每月帖子平均评论数 (TikTok @popmartglobal / Instagram @popmart)</p>
  <div class="chart-container">
    <div id="official-engagement-chart" class="chart-area"></div>
  </div>
</section>

<script define:vars={{ chartData }}>
  import('https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.esm.min.js').then(echarts => {
    var d = JSON.parse(chartData);
    var chart = echarts.init(document.getElementById('official-engagement-chart'));
    chart.setOption({
      tooltip: {
        trigger: 'axis',
        formatter: function(params) {
          var result = params[0].axisValue + '<br/>';
          params.forEach(function(p) {
            if (p.value !== null && p.value !== undefined) {
              var postCount = p.seriesName === 'TikTok' ? d.tiktokPosts[p.dataIndex] : d.instagramPosts[p.dataIndex];
              result += p.marker + ' ' + p.seriesName + ': ' + p.value.toFixed(1) + ' avg (' + postCount + ' posts)<br/>';
            }
          });
          return result;
        }
      },
      legend: { data: ['TikTok', 'Instagram'], bottom: 0 },
      grid: { left: 56, right: 20, top: 24, bottom: 48 },
      xAxis: {
        type: 'category',
        data: d.months,
        axisLabel: { rotate: 30, fontSize: 10 }
      },
      yAxis: {
        type: 'value',
        name: 'Avg Comments',
        nameTextStyle: { fontSize: 10 }
      },
      series: [
        {
          name: 'TikTok',
          type: 'bar',
          data: d.tiktok,
          itemStyle: { color: '#1a1a1a', borderRadius: [4, 4, 0, 0] },
          barMaxWidth: 32,
          label: {
            show: true,
            position: 'top',
            fontSize: 10,
            formatter: function(p) { return p.value !== null ? p.value.toFixed(0) : ''; }
          }
        },
        {
          name: 'Instagram',
          type: 'bar',
          data: d.instagram,
          itemStyle: {
            color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
              { offset: 0, color: '#E1306C' },
              { offset: 1, color: '#F77737' }
            ]),
            borderRadius: [4, 4, 0, 0]
          },
          barMaxWidth: 32,
          label: {
            show: true,
            position: 'top',
            fontSize: 10,
            formatter: function(p) { return p.value !== null ? p.value.toFixed(0) : ''; }
          }
        }
      ]
    });
    window.addEventListener('resize', function() { chart.resize(); });
  });
</script>

<style>
  .chart-subtitle {
    font-size: 13px; color: var(--color-muted);
    margin: -8px 0 16px 0;
  }
  .chart-container {
    background: var(--color-card); border-radius: 20px;
    padding: 32px; box-shadow: var(--shadow);
  }
  .chart-area { width: 100%; height: 400px; }
  @media (max-width: 768px) {
    .chart-area { height: 260px; }
    .chart-container { padding: 16px; border-radius: 14px; }
    .chart-subtitle { font-size: 11px; margin: -4px 0 10px 0; }
  }
</style>
