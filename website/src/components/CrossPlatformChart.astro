---
// website/src/components/CrossPlatformChart.astro
import crossPlatform from '../data/cross-platform-index.json';

const allData = crossPlatform as any[];
const months = [...new Set(allData.map((r: any) => r.month))].sort() as string[];
const platforms = ['TikTok', 'Instagram'];

const PLATFORM_COLORS: Record<string, string> = {
  TikTok: '#1a1a1a',
  Instagram: '#E1306C',
};

const series = platforms.map(platform => ({
  name: platform,
  type: 'line',
  smooth: true,
  symbol: 'circle',
  symbolSize: 6,
  data: months.map(m => {
    const row = allData.find((r: any) => r.month === m && r.platform === platform);
    return row ? row.index : null;
  }),
  itemStyle: { color: PLATFORM_COLORS[platform] },
  lineStyle: { color: PLATFORM_COLORS[platform], width: 2 },
  connectNulls: true,
}));

const totalMonths = months.length;
const xInterval = totalMonths > 10 ? Math.ceil(totalMonths / 10) - 1 : 0;

const chartData = JSON.stringify({ months, series, xInterval });
---
<section class="section">
  <div class="section-header">
    <h2>跨平台热度指数</h2>
    <span class="en">Cross-Platform Index</span>
  </div>
  <div class="chart-container">
    <div id="cross-platform-chart" class="chart-area"></div>
  </div>
</section>

<script define:vars={{ chartData }}>
  import('https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.esm.min.js').then(echarts => {
    const data = JSON.parse(chartData);
    const chart = echarts.init(document.getElementById('cross-platform-chart'));
    chart.setOption({
      tooltip: {
        trigger: 'axis',
        formatter: function(params) {
          let result = params[0].axisValue + '<br/>';
          params.forEach(function(p) {
            if (p.value !== null && p.value !== undefined) {
              result += p.marker + ' ' + p.seriesName + ': ' + p.value.toFixed(1) + '<br/>';
            }
          });
          return result;
        }
      },
      legend: { data: ['TikTok', 'Instagram'], bottom: 0 },
      grid: { left: 56, right: 20, top: 24, bottom: 48 },
      xAxis: {
        type: 'category',
        data: data.months,
        axisLabel: { rotate: 30, fontSize: 10, interval: data.xInterval },
        boundaryGap: false
      },
      yAxis: {
        type: 'value',
        name: '指数',
        nameTextStyle: { fontSize: 10 }
      },
      series: data.series.concat([
        {
          name: 'Baseline',
          type: 'line',
          data: data.months.map(function() { return 100; }),
          lineStyle: { color: '#999', type: 'dashed', width: 1 },
          symbol: 'none',
          tooltip: { show: false },
          legendHoverLink: false,
          silent: true
        }
      ])
    });
    window.addEventListener('resize', () => chart.resize());
  });
</script>

<style>
  .chart-container {
    background: var(--color-card); border-radius: 20px;
    padding: 32px; box-shadow: var(--shadow);
  }
  .chart-area { width: 100%; height: 400px; }
  @media (max-width: 768px) {
    .chart-area { height: 260px; }
    .chart-container { padding: 16px; border-radius: 14px; }
  }
</style>
