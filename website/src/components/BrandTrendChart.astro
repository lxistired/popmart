---
// website/src/components/BrandTrendChart.astro
import brandTrend from '../data/brand-trend.json';

const months = (brandTrend as any[]).map((r: any) => r.month);
const comments = (brandTrend as any[]).map((r: any) => r.comments);
const density = (brandTrend as any[]).map((r: any) => r.density);

// Smart x-axis interval: if >10 months, show every N-th label
const totalMonths = months.length;
const xInterval = totalMonths > 10 ? Math.ceil(totalMonths / 10) - 1 : 0;

const chartData = JSON.stringify({ months, comments, density, xInterval });
---
<section class="section">
  <div class="section-header">
    <h2>品牌热度趋势</h2>
    <span class="en">Brand Buzz Trend</span>
  </div>
  <div class="chart-container">
    <div id="brand-trend-chart" class="chart-area"></div>
  </div>
</section>

<script define:vars={{ chartData }}>
  import('https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.esm.min.js').then(echarts => {
    const data = JSON.parse(chartData);
    const chart = echarts.init(document.getElementById('brand-trend-chart'));
    chart.setOption({
      tooltip: {
        trigger: 'axis',
        axisPointer: { type: 'cross' },
        formatter: function(params) {
          let result = params[0].axisValue + '<br/>';
          params.forEach(function(p) {
            result += p.marker + ' ' + p.seriesName + ': ' + p.value + '<br/>';
          });
          return result;
        }
      },
      grid: { left: 56, right: 60, top: 24, bottom: 56 },
      legend: { data: ['月度评论数', '评论密度'], bottom: 0 },
      xAxis: {
        type: 'category',
        data: data.months,
        axisLabel: { rotate: 30, fontSize: 10, interval: data.xInterval }
      },
      yAxis: [
        { type: 'value', name: '评论数', nameTextStyle: { fontSize: 10 } },
        {
          type: 'value', name: '密度', nameTextStyle: { fontSize: 10 },
          splitLine: { show: false }
        }
      ],
      series: [
        {
          name: '月度评论数',
          type: 'bar',
          yAxisIndex: 0,
          data: data.comments,
          barMaxWidth: 28,
          itemStyle: {
            color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
              { offset: 0, color: '#FF9800' },
              { offset: 1, color: '#FF6F00' }
            ]),
            borderRadius: [4, 4, 0, 0]
          }
        },
        {
          name: '评论密度',
          type: 'line',
          yAxisIndex: 1,
          data: data.density,
          smooth: true,
          symbol: 'circle',
          symbolSize: 5,
          lineStyle: { color: '#E53935', width: 2 },
          itemStyle: { color: '#E53935' }
        }
      ]
    });
    window.addEventListener('resize', () => chart.resize());
  });
</script>

<style>
  .chart-container {
    background: var(--color-card); border-radius: 20px;
    padding: 32px; box-shadow: var(--shadow);
  }
  .chart-area { width: 100%; height: 400px; }
  @media (max-width: 768px) {
    .chart-area { height: 260px; }
    .chart-container { padding: 16px; border-radius: 14px; }
  }
</style>
