---
// website/src/components/BrandVsUgcChart.astro
import brandVsUgc from '../data/brand-vs-ugc.json';

const raw = brandVsUgc as any;

// Categories and their keys
const categories = ['均播放量', '均点赞数', '互动率 (%)', '均评论数'];
const keys = ['avg_views', 'avg_likes', 'avg_er_pct', 'avg_comments'];

// Normalize to UGC=100
const ugcValues = keys.map(k => raw.ugc[k]);
const brandNorm = keys.map(k => Math.round((raw.brand[k] / raw.ugc[k]) * 100));
const ugcNorm = keys.map(() => 100);

// Raw values for top labels — K format for >999
function fmt(v: number): string {
  if (v >= 1000) return (v / 1000).toFixed(1) + 'K';
  return v.toFixed(1);
}
const brandLabels = keys.map(k => fmt(raw.brand[k]));
const ugcLabels = keys.map(k => fmt(raw.ugc[k]));

const chartData = JSON.stringify({
  categories,
  brandNorm,
  ugcNorm,
  brandLabels,
  ugcLabels,
});
---
<section class="section">
  <div class="section-header">
    <h2>品牌号 vs. UGC 效能对比</h2>
    <span class="en">Brand vs. UGC Performance</span>
  </div>
  <div class="chart-container">
    <div id="brand-vs-ugc-chart" class="chart-area"></div>
  </div>
</section>

<script define:vars={{ chartData }}>
  import('https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.esm.min.js').then(echarts => {
    const data = JSON.parse(chartData);
    const chart = echarts.init(document.getElementById('brand-vs-ugc-chart'));
    chart.setOption({
      tooltip: {
        trigger: 'axis',
        axisPointer: { type: 'shadow' },
        formatter: function(params) {
          let result = params[0].axisValue + '<br/>';
          params.forEach(function(p) {
            result += p.marker + ' ' + p.seriesName + ': ' + p.value + ' (UGC=100)<br/>';
          });
          return result;
        }
      },
      legend: { data: ['品牌号', 'UGC'], bottom: 0 },
      grid: { left: 48, right: 20, top: 40, bottom: 48 },
      xAxis: {
        type: 'category',
        data: data.categories,
        axisLabel: { fontSize: 11 }
      },
      yAxis: {
        type: 'value',
        name: 'UGC=100',
        nameTextStyle: { fontSize: 10 }
      },
      series: [
        {
          name: '品牌号',
          type: 'bar',
          data: data.brandNorm,
          itemStyle: { color: '#E53935', borderRadius: [4, 4, 0, 0] },
          label: {
            show: true,
            position: 'top',
            formatter: function(params) {
              return data.brandLabels[params.dataIndex];
            },
            fontSize: 10
          }
        },
        {
          name: 'UGC',
          type: 'bar',
          data: data.ugcNorm,
          itemStyle: { color: '#333', borderRadius: [4, 4, 0, 0] },
          label: {
            show: true,
            position: 'top',
            formatter: function(params) {
              return data.ugcLabels[params.dataIndex];
            },
            fontSize: 10
          }
        }
      ]
    });
    window.addEventListener('resize', () => chart.resize());
  });
</script>

<style>
  .chart-container {
    background: var(--color-card); border-radius: 20px;
    padding: 32px; box-shadow: var(--shadow);
  }
  .chart-area { width: 100%; height: 400px; }
</style>
